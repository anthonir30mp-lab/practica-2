@model SolicitudCredito

@{
    ViewData["Title"] = $"Solicitud #{Model.Id}";

    var badgeClass = Model.Estado switch
    {
        EstadoSolicitud.Pendiente => "bg-warning text-dark",
        EstadoSolicitud.Aprobado  => "bg-success",
        EstadoSolicitud.Rechazado => "bg-danger",
        _ => "bg-secondary"
    };
}

<h2 class="mb-4">Detalle de solicitud</h2>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Solicitud #@Model.Id</strong>
        <span class="badge @badgeClass fs-6">@Model.Estado</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Monto solicitado</dt>
            <dd class="col-sm-8">@Model.MontoSolicitado.ToString("C")</dd>

            <dt class="col-sm-4">Fecha de solicitud</dt>
            <dd class="col-sm-8">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                <span class="badge @badgeClass">@Model.Estado</span>
            </dd>

            @if (Model.Estado == EstadoSolicitud.Rechazado && !string.IsNullOrWhiteSpace(Model.MotivoRechazo))
            {
                <dt class="col-sm-4">Motivo de rechazo</dt>
                <dd class="col-sm-8">
                    <div class="alert alert-danger mb-0 py-2">
                        @Model.MotivoRechazo
                    </div>
                </dd>
            }
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        ← Volver al listado
    </a>
</div>
