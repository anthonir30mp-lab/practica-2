@model List<practica_2.Models.Notificacion>

@{
    ViewData["Title"] = "Mis notificaciones";
}

<h2 class="mb-4">Mis notificaciones</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No tienes notificaciones todavía.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Solicitud</th>
                    <th>Mensaje</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model)
                {
                    <tr>
                        <td>@n.Id</td>
                        <td>
                            <a asp-controller="Solicitudes" asp-action="Details" asp-route-id="@n.SolicitudId">
                                #@n.SolicitudId
                            </a>
                        </td>
                        <td>@n.Texto</td>
                        <td>@n.FechaProcesamientoUtc.ToString("dd/MM/yyyy HH:mm") UTC</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}